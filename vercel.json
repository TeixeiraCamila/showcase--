{
  "outputDirectory": ".",
  "buildCommand": "echo 'site estático; sem build step'",
  "functions": {
    "api/quotes.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/projects/:name", "destination": "/projects/:name/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/projects/:path*/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/projects/:path*/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    }
  ]
}
